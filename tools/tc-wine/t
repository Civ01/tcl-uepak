#!/bin/bash
# t shot NAME | t key KEYS... | t type TEXT | t win | t log [N]
export DISPLAY=:50
case "$1" in
  shot) import -window root /home/claude/tctest/$2.png ;;
  key) shift; for k in "$@"; do xdotool key --clearmodifiers "$k"; sleep 0.4; done ;;
  type) shift; xdotool type --delay 40 "$*" ;;
  win) xdotool search --onlyvisible --name ".+" 2>/dev/null | while read w; do echo "$w [$(xdotool getwindowname $w)] $(xdotool getwindowgeometry $w | sed -n 2,3p | tr -s ' ' | tr '\n' ' ')"; done ;;
  k) shift; env -u TMPDIR WINEDEBUG=-all WINEPREFIX=/tmp/wineprefix wine /home/claude/tctest/wkeys.exe "$@" 2>&1 | grep -v "^$" ;;
  dump) env -u TMPDIR WINEDEBUG=-all WINEPREFIX=/tmp/wineprefix wine /home/claude/tctest/wkeys.exe dump 2>&1 | grep -v "^$" ;;
  start) /home/claude/tctest/start.sh; sleep 9; n=$(env -u TMPDIR WINEDEBUG=-all WINEPREFIX=/tmp/wineprefix wine /home/claude/tctest/wkeys.exe dump 2>/dev/null | grep -A40 '"Total Commander"$' | grep -oE 'id=[0-9]+ "[123]"$' | head -1 | grep -oE '"[123]"' | tr -d '"'); echo "nag button: $n"; [ -n "$n" ] && env -u TMPDIR WINEDEBUG=-all WINEPREFIX=/tmp/wineprefix wine /home/claude/tctest/wkeys.exe focus:"Total Commander" $n ;;
  log) tail -n ${2:-30} /home/claude/tctest/plugins/uepak/uepak.log ;;
esac
